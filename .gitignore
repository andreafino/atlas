# Asset grezzi scaricati manualmente (es. zip delle Azure Architecture Icons), mai versionati:
# vedi scripts/import-azure-icons.mjs, che li legge da qui e copia solo l'output curato.
tmp/
# .env.local (non sensibile, versionato) fa eccezione al pattern *.local qui sopra;
# .env.local.user contiene segreti e non va mai versionato.
!env/.env.local
env/.env.local.user
env/.env.*.user

