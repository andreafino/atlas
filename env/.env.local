# Valori non sensibili per l'esecuzione/debug locale dell'app Teams.
# I segreti (client secret) vanno in env/.env.local.user, che NON va mai versionato
# (copia env/.env.local.user.sample e compilalo).
#
# Dove si trovano questi valori: vedi TEAMS_SETUP.md.

# Id dell'app Teams: è solo un GUID auto-generato (non richiede una registrazione), usato nel
# manifest. Lo stesso valore è già dentro appPackage/manifest.ui-only.json (test rapido senza SSO).
TEAMS_APP_ID=5c332e6b-55c6-4e00-859c-f891d2b61c06

# App registration Entra ID usata per l'SSO della tab.
AAD_APP_CLIENT_ID=
AAD_APP_TENANT_ID=
AAD_APP_OAUTH_AUTHORITY_HOST=https://login.microsoftonline.com

# Dominio e URL su cui gira il frontend (senza protocollo per TAB_DOMAIN).
TAB_DOMAIN=localhost:5173
TAB_ENDPOINT=https://localhost:5173

# URL del backend (Azure Functions) con l'endpoint di scambio token (OBO) verso Graph.
API_ENDPOINT=http://localhost:7071/api
